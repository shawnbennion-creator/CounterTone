<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<meta name="description" content="Countertone — premium live music for corporate events, private parties and weddings throughout Southern California. Acoustic guitar, vocals and improvisational Harmon-muted trumpet weave through familiar songs in a distinctive live experience." />
<title>Countertone | Familiar Songs. Transformed Live.</title>
<style>
  :root{
    --ink:#0a0b0d;
    --ink2:#101318;
    --paper:#f5f1e9;
    --paper2:#ebe5da;
    --muted:#b7b3aa;
    --line:rgba(255,255,255,.13);
    --gold:#c8a968;
    --gold2:#e5cd98;
    --white:#f8f6f1;
    --serif: Georgia, 'Times New Roman', serif;
    --sans: 'Helvetica Neue', Helvetica, Arial, sans-serif;
  }
  *{box-sizing:border-box}
  html{scroll-behavior:smooth}
  body{margin:0;background:var(--ink);color:var(--white);font-family:var(--sans);line-height:1.55}
  a{color:inherit;text-decoration:none}
  .wrap{width:min(1180px,92vw);margin:auto}
  .eyebrow{letter-spacing:.19em;text-transform:uppercase;font-size:.72rem;color:var(--gold2);font-weight:700}
  .btn{display:inline-flex;align-items:center;justify-content:center;gap:.6rem;padding:14px 21px;border:1px solid rgba(255,255,255,.22);border-radius:999px;font-weight:700;letter-spacing:.04em;transition:.2s ease;background:transparent}
  .btn:hover{transform:translateY(-2px);border-color:var(--gold2)}
  .btn.primary{background:var(--gold);color:#13100a;border-color:var(--gold)}
  .btn.primary:hover{background:var(--gold2)}
  .nav{position:fixed;top:0;left:0;right:0;z-index:20;background:rgba(10,11,13,.78);backdrop-filter:blur(18px);border-bottom:1px solid rgba(255,255,255,.07)}
  .navin{height:76px;display:flex;align-items:center;justify-content:space-between}
  .wordmark{font-family:var(--serif);letter-spacing:.18em;font-weight:700;font-size:1rem}
  .navlinks{display:flex;gap:28px;font-size:.84rem;color:#d9d5cb}
  .navlinks a:hover{color:var(--gold2)}
  .hero{min-height:94vh;display:grid;align-items:center;position:relative;overflow:hidden;border-bottom:1px solid rgba(255,255,255,.08)}
  .hero:before{content:"";position:absolute;inset:0;background:radial-gradient(circle at 75% 35%, rgba(200,169,104,.16), transparent 31%),radial-gradient(circle at 20% 70%, rgba(255,255,255,.05), transparent 35%),linear-gradient(135deg,#090a0c,#11151a 55%,#090a0c)}
  .hero-grid{position:relative;z-index:1;display:grid;grid-template-columns:1.05fr .95fr;gap:44px;padding-top:110px;padding-bottom:65px}
  h1{font-family:var(--serif);font-weight:500;letter-spacing:.06em;font-size:clamp(3.6rem,8vw,7.8rem);line-height:.87;margin:18px 0 25px}
  .hero h2{font-size:clamp(1.1rem,2vw,1.55rem);font-weight:500;max-width:640px;color:#e9e5dc;margin:0 0 22px}
  .hero-copy{font-size:1.05rem;color:#bab9b4;max-width:600px}
  .hero-actions{display:flex;gap:12px;flex-wrap:wrap;margin-top:30px}
  .hero-note{display:flex;gap:22px;flex-wrap:wrap;margin-top:30px;color:#c7c3ba;font-size:.84rem}
  .hero-note span{position:relative;padding-left:14px}.hero-note span:before{content:"";position:absolute;left:0;top:.62em;width:5px;height:5px;border-radius:50%;background:var(--gold)}
  .hero-art{display:flex;align-items:center;justify-content:center;min-height:520px;position:relative}
  .art-box{width:min(520px,100%);aspect-ratio:1/1;position:relative;border:1px solid rgba(255,255,255,.12);background:linear-gradient(145deg,rgba(255,255,255,.03),rgba(255,255,255,.015));overflow:hidden}
  .art-box:before,.art-box:after{content:"";position:absolute;border:1px solid rgba(200,169,104,.42);border-radius:50%;filter:blur(.1px)}
  .art-box:before{width:80%;height:37%;left:10%;top:30%;transform:rotate(-17deg)}
  .art-box:after{width:82%;height:36%;left:8%;top:39%;transform:rotate(17deg);border-color:rgba(255,255,255,.25)}
  .line1,.line2,.line3{position:absolute;height:2px;left:7%;right:7%;transform-origin:center;border-radius:2px}
  .line1{top:43%;background:linear-gradient(90deg,transparent,var(--gold2),transparent);transform:rotate(-10deg)}
  .line2{top:50%;background:linear-gradient(90deg,transparent,rgba(255,255,255,.85),transparent);transform:rotate(8deg)}
  .line3{top:57%;background:linear-gradient(90deg,transparent,rgba(200,169,104,.75),transparent);transform:rotate(-4deg)}
  .art-label{position:absolute;inset:auto 32px 30px 32px;display:flex;justify-content:space-between;align-items:end}
  .art-label .big{font-family:var(--serif);font-size:2.35rem;letter-spacing:.06em}.art-label .small{font-size:.72rem;letter-spacing:.17em;color:var(--gold2);text-transform:uppercase}
  .section{padding:105px 0}
  .light{background:var(--paper);color:#191a1c}
  .light .eyebrow{color:#7c6533}
  .section-head{max-width:790px;margin-bottom:48px}
  .section h2{font-family:var(--serif);font-weight:500;font-size:clamp(2.3rem,5vw,4.2rem);line-height:1.02;margin:14px 0 17px;letter-spacing:-.02em}
  .section-lead{font-size:1.12rem;color:#666158;max-width:730px}
  .dark-copy{color:#c2c0bb}
  .split{display:grid;grid-template-columns:1fr 1fr;gap:60px;align-items:center}
  .card-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:18px}
  .card{padding:31px;border:1px solid rgba(0,0,0,.11);background:rgba(255,255,255,.42);min-height:220px}
  .dark .card{border-color:var(--line);background:rgba(255,255,255,.025)}
  .card h3{font-family:var(--serif);font-size:1.65rem;font-weight:500;margin:9px 0 12px}
  .card p{color:#6c675f;margin:0}.dark .card p{color:#b6b3ac}
  .number{font-size:.75rem;letter-spacing:.18em;color:var(--gold2);font-weight:700}
  .quote{border-left:2px solid var(--gold);padding:7px 0 7px 24px;font-family:var(--serif);font-size:1.7rem;line-height:1.25;color:#242327}
  .dark .quote{color:#f1ede5}
  .sound-visual{height:430px;border:1px solid rgba(255,255,255,.12);background:linear-gradient(135deg,#11151a,#090a0c);position:relative;overflow:hidden}
  .sound-visual .tag{position:absolute;left:28px;top:25px;color:var(--gold2);font-size:.7rem;letter-spacing:.18em;text-transform:uppercase}
  .sound-visual svg{position:absolute;inset:0;width:100%;height:100%}
  .energy{display:grid;grid-template-columns:repeat(4,1fr);gap:2px;background:rgba(255,255,255,.1)}
  .energy div{padding:28px 25px;background:#111318}.energy h3{font-family:var(--serif);font-size:1.55rem;margin:0 0 6px;font-weight:500}.energy p{margin:0;color:#a9a7a1;font-size:.93rem}
  .repertoire{display:flex;flex-wrap:wrap;gap:9px;margin-top:28px}.pill{border:1px solid rgba(255,255,255,.15);padding:9px 13px;border-radius:999px;font-size:.8rem;color:#d5d0c8;background:rgba(255,255,255,.03)}
  .sample-list{display:grid;grid-template-columns:repeat(3,1fr);gap:10px}.song{padding:13px 0;border-bottom:1px solid rgba(255,255,255,.1);color:#d6d2ca;font-size:.92rem}.song span{color:#8f8b83}
  .video-shell{aspect-ratio:16/9;border:1px solid rgba(0,0,0,.13);background:#111;color:#ddd;display:grid;place-items:center;position:relative;overflow:hidden}
  .video-shell .play{width:82px;height:82px;border-radius:50%;border:1px solid rgba(255,255,255,.65);display:grid;place-items:center;font-size:1.5rem;padding-left:3px}
  .video-shell small{position:absolute;bottom:16px;left:18px;letter-spacing:.1em;text-transform:uppercase;color:#aaa}
  .bio{font-size:1.02rem;color:#5f5b54}
  .bio strong{color:#232225}
  .trust{display:grid;grid-template-columns:repeat(3,1fr);gap:18px;margin-top:40px}
  .trustbox{padding:25px;border-top:1px solid rgba(0,0,0,.16)}
  .trustbox strong{display:block;margin-bottom:7px}
  .cta{padding:95px 0;background:radial-gradient(circle at 70% 50%, rgba(200,169,104,.19), transparent 30%),#0b0d10}
  .cta-inner{display:grid;grid-template-columns:1.15fr .85fr;gap:50px;align-items:center}
  .cta h2{margin-top:11px}
  form{display:grid;gap:13px}.field{width:100%;padding:15px 16px;background:#12151a;border:1px solid rgba(255,255,255,.14);color:#f3f0e9;border-radius:8px;font:inherit}.field::placeholder{color:#77766f}textarea.field{min-height:115px;resize:vertical}
  .fineprint{font-size:.76rem;color:#77766f;margin-top:10px}
  footer{padding:30px 0;color:#7f7d77;font-size:.8rem;border-top:1px solid rgba(255,255,255,.08)}
  .footerin{display:flex;justify-content:space-between;gap:15px;flex-wrap:wrap}
  @media(max-width:900px){.hero-grid,.split,.cta-inner{grid-template-columns:1fr}.hero{min-height:auto}.hero-art{min-height:420px}.card-grid,.energy,.trust{grid-template-columns:1fr 1fr}.sample-list{grid-template-columns:1fr 1fr}.navlinks{display:none}}
  @media(max-width:600px){.section{padding:75px 0}.card-grid,.energy,.trust,.sample-list{grid-template-columns:1fr}.hero-art{min-height:330px}.art-label .big{font-size:1.8rem}.hero-grid{padding-top:110px}.btn{width:100%}.hero-actions{flex-direction:column}.video-shell{margin-top:25px}}
</style>
</head>
<body>
  <nav class="nav">
    <div class="wrap navin">
      <a href="#top" class="wordmark">COUNTERTONE</a>
      <div class="navlinks">
        <a href="#sound">The Sound</a><a href="#experience">The Experience</a><a href="#repertoire">Repertoire</a><a href="#shawn">About Shawn</a>
